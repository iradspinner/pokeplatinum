{
  "permissions": {
    "allow": [
      "Bash(tools/oxide/integrate.sh *)",
      "Bash(bash tools/oxide/integrate.sh *)",
      "Bash(bash tools/oxide/sync-docs.sh)",
      "Bash(git merge *)",
      "Bash(git commit *)",
      "Bash(git push origin oxide)",
      "Bash(git fetch *)"
    ]
  },
  "enabledPlugins": {
    "superpowers@anthropic-plugin-directory": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/oxidex_autostart.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/oxide_guard.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/style_check.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
