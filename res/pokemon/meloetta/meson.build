species_data_files += files('data.json', 'sprite_data.json')
species_data_files += files('forms/pirouette/data.json')

poke_icon_files += files('icon.png')
meloetta_pirouette_icon = files('forms/pirouette/icon.png')

pokegra_files += files('male_back.png')
pokegra_files += files('male_front.png')

# Aria is the ordinary sprite in pl_pokegra. Pirouette's go in pl_otherpoke
# after everything vanilla has there, on the same appended list as Arceus's
# Fairy form (element 7). Arceus is read first, so these are
# pokemon_z_04_meloetta_pirouette_back_NCGR to _07_..._shiny_NCLR in the naix,
# the names pokemon.c looks them up by.
otherpoke_appended += files(
    'forms/pirouette/back.png',
    'forms/pirouette/front.png',
    'forms/pirouette/normal.pal',
    'forms/pirouette/shiny.pal',
)

pokefoot_files += files('footprint.png')
