{
  "key": 50231,
  "messages": [
    {
      "id": "TurnbackCaveGiratinaRoom_Text_GiratinaCry",
      "en_US": "...Bishaan!\r"
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_GiratinaDisappeared",
      "en_US": "GIRATINA disappeared..."
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_GoToDistortionWorld",
      "en_US": [
        "It’s a portal leading to the\n",
        "Distortion World...\r",
        "Would you like to leap into the portal\n",
        "and go to the Distortion World?"
      ]
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_PlayerLeaptIntoPortal",
      "en_US": "{STRVAR_1 3, 0, 0} leapt into the portal.\r"
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_PlaceWhereWorldsOverlap",
      "en_US": [
        "This is...\r",
        "That where life sparkles...\n",
        "That where life has faded...\r",
        "A place where two worlds overlap..."
      ]
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_5",
      "en_US": [
        "So we meet again...\r",
        "It would seem like our fates\n",
        "have become intertwined?"
      ]
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_6",
      "en_US": [
        "Here and now, I will\n",
        "finally break that bond!\r"
      ]
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_7",
      "en_US": "Farewell."
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_8",
      "en_US": [
        "Had I met you sooner...\r",
        "Would things have been\n",
        "different for me...?"
      ]
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_9",
      "en_US": "..."
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_10",
      "en_US": "You can now teleport here!"
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_11",
      "en_US": [
        "Do you want to go back at the\n",
        "beginning?"
      ]
    }
  ]
}
