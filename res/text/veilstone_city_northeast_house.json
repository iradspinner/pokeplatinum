  "key": 9267,
  "messages": [
    {
      "id": "VeilstoneCityNortheastHouse_Text_GalacticsBuildingBugsMe",
      "en_US": [
        "Team Galactic’s building bugs me so\n",
        "much, I can’t sleep well.\r",
        "It’s so bizarre, like a robot that’s\n",
        "about to start moving."
      ]
    },
    {
      "id": "VeilstoneCityNortheastHouse_Text_IDontUnderstandTheirIdea",
      "en_US": [
        "Those thorny things on the building...\n",
        "The way it moves meaninglessly...\r",
        "I don’t understand their idea of \n",
        "“awesomely fashionable” at all.\r",
        "Still, Team Galactic does seem to have\n",
        "a huge supply of energy."
      ]
    }
  ]
}
