#!/bin/sh
# Get a playtest ROM built on GitHub's machines instead of this box's CPU.
#
# Ian's i9-14900K is degraded, so a local build can come out wrong. The private
# repo iradspinner/oxide-rom-builder holds one workflow that checks out this
# repo at a given commit, builds it, and keeps the ROM as a private artifact.
# This script starts that build, waits for it, downloads the ROM and checks it
# against the SHA-1 the build recorded. The ROM is never published: the source
# repo is public, the builder is not.
#
# Usage: tools/oxide/fetch-rom [--testkit] [commit-or-branch]    default: HEAD
#
# --testkit builds the test kit (`make testkit`, docs/oxide/test-kit.md) in
# place of the ordinary ROM. Its runs are titled "testkit <commit>" rather than
# "build <commit>", and its files are named pokeplatinum-oxide-testkit-<commit>.
#
# The commit has to be pushed already, because the builder reads it from
# GitHub. If a successful build is still inside its three-day retention, of
# that commit or of the newest ancestor that differs from it only in Markdown,
# it is reused rather than built again: a docs-only commit builds the same ROM
# as its parent. The files are then named for the commit that was built.
#
# Output goes to $OXIDE_PLAYTEST_DIR (default ~/oxide-playtest), one file per
# commit, and the script prints the path to paste into Windows Explorer.

set -eu

REPO=iradspinner/oxide-rom-builder
WORKFLOW=build.yml
DEST=${OXIDE_PLAYTEST_DIR:-$HOME/oxide-playtest}

die() { printf 'fetch-rom: %s\n' "$*" >&2; exit 1; }

cd "$(dirname "$0")/../.."
target=rom
title_word=build
kind=
if [ "${1:-}" = --testkit ]; then
    target=testkit
    title_word=testkit
    kind=testkit-
    shift
fi
ref=${1:-HEAD}
commit=$(git rev-parse --verify "$ref^{commit}") || die "no such commit: $ref"
short=$(printf '%s' "$commit" | cut -c1-9)

gh repo view "$REPO" >/dev/null 2>&1 ||
    die "cannot reach $REPO; it must exist and the gh token needs access to it"
git fetch -q origin || die "git fetch failed"
[ -n "$(git branch -r --contains "$commit" 2>/dev/null)" ] ||
    die "$short is not on GitHub yet; push it first"

# The workflow titles each run "build <ref>" (or "testkit <ref>"), so a run for
# this exact commit can be found again by its title.
title="$title_word $commit"
find_run() {
    gh run list -R "$REPO" --workflow "$WORKFLOW" -L 30 \
        --json databaseId,displayTitle,conclusion,createdAt \
        -q "[.[] | select(.displayTitle == \"$title\") $1] | sort_by(.createdAt) | last | .databaseId // empty"
}

# Successful builds as "<commit> <run id>", then the newest ancestor of the
# commit that has one and differs from it in Markdown alone. The exclusion is
# exactly *.md, the same filter the public workflow skips pushes on, because
# the build reads everything else, tools/ included.
built=$(gh run list -R "$REPO" --workflow "$WORKFLOW" -L 100 \
    --json databaseId,displayTitle,conclusion \
    -q ".[] | select(.conclusion == \"success\" and (.displayTitle | startswith(\"$title_word \"))) | \"\(.displayTitle | ltrimstr(\"$title_word \")) \(.databaseId)\"")
reuse=
for candidate in $(git rev-list --max-count=200 "$commit" | awk -v built="$built" '
        BEGIN { n = split(built, line, "\n"); for (i = 1; i <= n; i++) { split(line[i], f, " "); run[f[1]] = f[2] } }
        ($1 in run) { print $1 ":" run[$1] }'); do
    if git diff --quiet "${candidate%:*}" "$commit" -- . ':(exclude)*.md'; then
        reuse=$candidate
        break
    fi
done

run=${reuse#*:}
reuse=${reuse%:*}
rshort=$(printf '%s' "$reuse" | cut -c1-9)
if [ -n "$reuse" ] && gh run download "$run" -R "$REPO" -n "pokeplatinum-oxide-$kind$rshort" \
        -D "$DEST/.incoming-$kind$rshort" >/dev/null 2>&1; then
    if [ "$reuse" = "$commit" ]; then
        echo "reusing build $run of $short"
    else
        echo "reusing build $run of $rshort: $short differs from it only in Markdown, so the ROM is the same"
        short=$rshort
    fi
else
    [ -z "$reuse" ] || rm -rf "$DEST/.incoming-$kind$rshort"
    rm -rf "$DEST/.incoming-$kind$short"
    # Only a run created after this moment can be ours; an older run of the
    # same commit (a failed one, say) must not be mistaken for it.
    since=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    # The target input is passed only for the kit, so the ordinary build asks
    # the builder exactly what it always has.
    if [ "$target" = rom ]; then
        set -- -f ref="$commit"
    else
        set -- -f ref="$commit" -f target="$target"
    fi
    gh workflow run "$WORKFLOW" -R "$REPO" "$@" >/dev/null ||
        die "could not start the build; does the token reach $REPO with Actions write?"
    echo "started a build of $short on GitHub, usually about five minutes"
    run=
    tries=0
    while [ -z "$run" ]; do
        tries=$((tries + 1))
        [ "$tries" -le 30 ] || die "the build never appeared in $REPO's run list"
        sleep 4
        run=$(find_run "| select(.createdAt >= \"$since\")")
    done
    # Poll rather than `gh run watch`: watch also reads check annotations,
    # which needs a Checks permission the fine-grained token does not have,
    # and it gives up on the first 403 while the build is still running.
    while :; do
        sleep 20
        state=$(gh run view "$run" -R "$REPO" --json status,conclusion \
            -q '"\(.status) \(.conclusion)"') || continue
        case "$state" in
            "completed success") break ;;
            completed*) die "build $run ended ${state#completed }; see: gh run view $run -R $REPO --log-failed" ;;
        esac
    done
    gh run download "$run" -R "$REPO" -n "pokeplatinum-oxide-$kind$short" \
        -D "$DEST/.incoming-$kind$short" || die "download of build $run failed"
fi

# Trust the file only if it hashes to what the build machine recorded.
(cd "$DEST/.incoming-$kind$short" && sha1sum -c --quiet "pokeplatinum-oxide-$kind$short.sha1") ||
    die "downloaded ROM does not match the build's SHA-1"
mv -f "$DEST/.incoming-$kind$short/pokeplatinum-oxide-$kind$short.nds" "$DEST/"
mv -f "$DEST/.incoming-$kind$short/pokeplatinum-oxide-$kind$short.sha1" "$DEST/"
rmdir "$DEST/.incoming-$kind$short"

rom="$DEST/pokeplatinum-oxide-$kind$short.nds"
echo "ROM:     $rom"
echo "SHA-1:   $(cut -d' ' -f1 "$DEST/pokeplatinum-oxide-$kind$short.sha1")"
case "$rom" in
    "$HOME"/*) printf 'Windows: \\\\wsl$\\%s%s\n' "${WSL_DISTRO_NAME:-Ubuntu}" \
                   "$(printf '%s' "$rom" | sed 's|/|\\|g')" ;;
esac
