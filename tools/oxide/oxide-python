#!/bin/sh
# The Python this project runs on, resolved in one place.
#
# Platinum Oxide pins the interpreter because this machine's system Python,
# Ubuntu 26.04's 3.14.4-1ubuntu0.2, intermittently returns wrong answers from
# pure-Python string work. It is not the hardware and it is not Python 3.14 in
# general: the same repro on the same machine failed 10 of 15 runs on that
# build and 0 of 15 on CPython 3.13.15, measured 2026-09-22. It matters beyond
# the tools because `make rom` runs Python about 227 times to generate event
# data, map matrices and the encounter archives, so the build is exposed too.
# `tools/oxide/python_flake_repro.py` is the regression check.
#
# CPython 3.14.7 was tried and rejected: the astral build is compiled
# --with-tail-call-interp, and that interpreter aborted a `meson setup` with
# "Fatal Python error: _TAIL_CALL_CACHE: Executing a cache." An interpreter
# that can kill the build configuration is worse than one that occasionally
# returns a wrong string. 3.13 has no tail-call interpreter.
#
# Resolution order, first hit wins:
#   $OXIDE_PYTHON          an explicit override, for a machine set up differently
#   ~/.venvs/oxide         the pinned venv (3.13 plus ndspy, Pillow, openpyxl)
#   uv python find 3.13    a uv-managed 3.13 without the extra packages
#   python3                whatever is on PATH, with a warning
#
# Usage: tools/oxide/oxide-python script.py [args...]
#        tools/oxide/oxide-python --path        print the interpreter and exit

set -eu

resolve() {
    if [ -n "${OXIDE_PYTHON:-}" ]; then
        if [ -x "${OXIDE_PYTHON}" ]; then
            printf '%s\n' "${OXIDE_PYTHON}"
            return
        fi
        echo "oxide-python: OXIDE_PYTHON=${OXIDE_PYTHON} is not executable, ignoring it" >&2
    fi
    if [ -x "${HOME}/.venvs/oxide/bin/python" ]; then
        printf '%s\n' "${HOME}/.venvs/oxide/bin/python"
        return
    fi
    for uv in "${HOME}/.local/bin/uv" uv; do
        if command -v "${uv}" >/dev/null 2>&1; then
            found=$("${uv}" python find 3.13 2>/dev/null || true)
            if [ -n "${found}" ] && [ -x "${found}" ]; then
                echo "oxide-python: no ~/.venvs/oxide, using a bare uv 3.13 (${found}) without ndspy, Pillow or openpyxl; see the setup doc" >&2
                printf '%s\n' "${found}"
                return
            fi
        fi
    done
    echo "oxide-python: falling back to python3; see the comment in this file" >&2
    command -v python3
}

PY=$(resolve)

if [ "${1:-}" = "--path" ]; then
    printf '%s\n' "${PY}"
    exit 0
fi

exec "${PY}" "$@"
